@model HomePageViewModel
@{
    ViewData["Title"] = "";
    var p = Model.Portfolio;
    var contactVm = new ContactViewModel
    {
        Content = p.Contact,
        Form = Model.ContactForm,
        Status = Model.Status,
    };
}

<partial name="Sections/_Hero" model="p.Hero" />
<partial name="Sections/_Skills" model="p.Skills" />
<partial name="Sections/_Experience" model="p.Experience" />
<partial name="Sections/_Education" model="p.Education" />
<partial name="Sections/_Certificates" model="p.Certificates" />
<partial name="Sections/_Projects" model="p.Projects" />
<partial name="Sections/_Contact" model="contactVm" />

@if (ViewData["ScrollToContact"] is true)
{
    <script>
        window.addEventListener('load', function () {
            var el = document.getElementById('contact');
            if (el) el.scrollIntoView({ behavior: 'smooth' });
        });
    </script>
}
