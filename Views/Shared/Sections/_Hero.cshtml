@model HeroViewModel

<section id="home" class="hero">
    <div class="hero-grid">
        <div class="hero-text">
            <div class="hero-avatar-row">
                <img class="hero-avatar" src="@Model.AvatarPath" alt="@Model.Name" />
                <div class="bubble">
                    <span class="bubble-tail"></span>
                    <span class="bubble-quote-mark" aria-hidden="true">&ldquo;</span>
                    <p class="bubble-text">@Model.Quote</p>
                    <p class="bubble-author">@Model.QuoteAuthor</p>
                </div>
            </div>

            <p class="hero-role">@Model.Role</p>

            <h1 class="hero-title">
                @Model.Greeting <span class="accent">@Model.Name</span>@Model.GreetingSuffix
            </h1>

            <p class="hero-stack">@Model.TechStack</p>

            <div class="hero-actions">
                <button type="button" class="btn btn-primary" data-scroll-to="projects">
                    @Model.ViewProjectsLabel
                </button>
                <a class="btn btn-secondary" href="@Model.CvPath" target="_blank" rel="noopener noreferrer">
                    <span>@Model.DownloadCvLabel</span>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                </a>
            </div>

            <div class="hero-stats">
                @foreach (var stat in Model.Stats)
                {
                    <div>
                        <div class="stat-value">@stat.Value</div>
                        <div class="stat-label">@stat.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="hero-codecard">
            <partial name="Sections/_CodeCard" />
        </div>
    </div>
</section>
