<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Pedro Widya — Web Developer</title>
    <meta name="description" content="Portfolio of Pedro Widya, a web developer working with JavaScript, TypeScript, React, and PostgreSQL." />

    <script type="importmap"></script>

    @* Anti-flash: terapkan tema tersimpan sebelum halaman dilukis, agar tidak berkedip. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("Navbar")

    <main role="main">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/scroll.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
